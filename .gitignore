# ── Secrets & local config (NEVER commit) ──────────────────────────────
.env
*.env
!.env.example
backend/.env
frontend/.env

# ── Python / backend ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.sqlite3
*.db

# ── Editor / OS ────────────────────────────────────────────────────────
.DS_Store
.history
.idea/
*.iml
*.log
*.swp

# ── Kubernetes: never commit real secret manifests ─────────────────────
k8s/**/secret.yaml
k8s/**/*secret*.yaml
!k8s/**/*secret*.example.yaml