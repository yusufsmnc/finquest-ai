# ── Copy to backend/.env and fill in. NEVER commit the real .env. ──────────
# In Kubernetes (Faz 5) these come from ConfigMap (non-secret) + Secret (secret).

# ── ConfigMap-style (non-secret, varies per environment) ───────────────────
ENVIRONMENT=development
LOG_LEVEL=info
API_BASE_URL=http://localhost:8000
# Allowed frontend origins for CORS (comma-separated). The Flutter web dev
# server runs on :5000 (see `flutter run --web-port=5000`).
CORS_ORIGINS=http://localhost:5000,http://localhost:8080
AI_MODEL=claude-opus-4-8

# ── Secret-style (leaking causes harm) ─────────────────────────────────────
# PostgreSQL connection. With docker-compose (Faz 0/4) postgres runs on :5432.
DATABASE_URL=postgresql+psycopg://finquest:finquest@localhost:5432/finquest
# Auth signing key — generate a long random string, keep it private.
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── AI (Faz 3). Lives ONLY in the backend, never in the frontend. ──────────
ANTHROPIC_API_KEY=