# ── docker-compose environment template (Faz 4) ────────────────────────────
# Copy to `.env` and fill in. `.env` is git-ignored — NEVER commit it.
#
#   cp .env.example .env
#   docker compose up --build
#
# Rule of thumb (CLAUDE.md): if leaking it causes harm → Secret; if it just
# varies per environment → ConfigMap. In Faz 5 the two blocks below become
# exactly that: a Kubernetes ConfigMap and a Kubernetes Secret.
#
# Note: `backend/.env` is the separate template for running the backend
# directly on the host (no containers). Compose does not read it — the backend
# container gets its values from this file, via docker-compose.yml.

# ── ConfigMap-style (non-secret, varies per environment) ───────────────────
ENVIRONMENT=development
LOG_LEVEL=info
# The URL the BROWSER uses to reach the backend. It is compiled into the
# Flutter web bundle (build arg), so it must be host-reachable — never a
# compose service name like http://backend:8000.
API_BASE_URL=http://localhost:8000
# Origins the backend accepts CORS requests from: the frontend's published
# port (8080), plus the Flutter web dev server (5000) for host-side work.
CORS_ORIGINS=http://localhost:8080,http://localhost:5000
# Mentor chat model — keep it small and cheap.
AI_MODEL=gpt-4o-mini
# Host port for psql access to the database container. Change it if a local
# PostgreSQL already owns 5432.
POSTGRES_HOST_PORT=5432

# ── Secret-style (leaking causes harm) ─────────────────────────────────────
# PostgreSQL credentials. The backend's DATABASE_URL is assembled from these
# in docker-compose.yml and points at the `db` service, so there is one
# source of truth and no connection string to keep in sync.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Auth signing key — generate a long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ── AI (Faz 3). Lives ONLY in the backend, never in the frontend. ──────────
# Leave empty to run without an LLM: the mentor then serves its pre-seeded
# static messages and the app keeps working normally.
OPENAI_API_KEY=
